generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  savedSpots    SavedSpot[]
  sessions      Session[]
  surfSessions  SurfSession[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SurfSpot {
  id                String      @id @default(cuid())
  slug              String      @unique
  name              String
  region            String
  country           String
  lat               Float
  lng               Float
  description       String?
  difficulty        String      @default("intermediate")
  facingDirection   Float       @default(180)
  noaaTideStationId String?
  noaaBuoyId        String?
  webcamUrl         String?
  webcamType        String?
  createdAt         DateTime    @default(now())
  savedBy           SavedSpot[]
}

model SavedSpot {
  id        String   @id @default(cuid())
  userId    String
  spotId    String
  createdAt DateTime @default(now())
  spot      SurfSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotId])
}

model SurfSession {
  id           String   @id @default(cuid())
  userId       String
  spotName     String
  spotSlug     String?
  region       String?
  sessionDate  DateTime
  duration     Int?
  waveHeightFt Float?
  wavePeriod   Int?
  windSpeed    Float?
  windDir      String?
  waterTempC   Float?
  boardType    String?
  wetsuitMm    String?
  rating       Int?
  highlights   String?
  buddies      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
