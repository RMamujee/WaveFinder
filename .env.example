# ---------------------------------------------------------------------------
# WaveFinder environment variables
#
# Copy this file to `.env.local` for local development and fill in real values.
# These are PLACEHOLDERS only — never commit real secrets.
# Only variables the application code actually reads are listed here.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ------------------------------------------------
# Pooled connection string (PgBouncer endpoint) used by the app at runtime.
# In production append: ?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooler) connection string used by Prisma for migrations / db push.
DIRECT_URL="postgresql://user:password@direct-host/dbname?sslmode=require"

# --- Authentication (better-auth) -------------------------------------------
# Base URL the auth server runs at (e.g. http://localhost:3000 in dev).
BETTER_AUTH_URL="http://localhost:3000"
# Secret used to sign sessions. MUST be a 64-char random string in production.
BETTER_AUTH_SECRET="replace-with-a-64-char-random-string"

# --- Public site URLs --------------------------------------------------------
# Canonical site URL (used for metadata, sitemap, robots, Stripe redirects).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Legacy app URL fallback (used by Stripe getAppUrl when SITE_URL is unset).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
# Price IDs for the Pro subscription plans (monthly + annual).
STRIPE_PRO_MONTHLY_PRICE_ID="price_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PRO_ANNUAL_PRICE_ID="price_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Upstash Redis (rate limiting) ------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# --- Feature flags -----------------------------------------------------------
# Set to "true" to enable the /api/debug/conditions endpoint (off by default).
ENABLE_DEBUG_API="false"

# ---------------------------------------------------------------------------
# Optional — the app runs without these, but they enable extra features.
# ---------------------------------------------------------------------------

# --- Email (Resend) ----------------------------------------------------------
# When set, account email-verification messages are sent via Resend.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender for verification emails (falls back to onboarding@resend.dev).
RESEND_FROM="WaveFinder <noreply@yourdomain.com>"

# --- Error monitoring (Sentry) ----------------------------------------------
# Server-side DSN.
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# Client-side DSN (exposed to the browser).
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
