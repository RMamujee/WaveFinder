# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local SQLite database
prisma/*.db

# oh-my-claudecode local state
.omc/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Claude Code agent worktrees and local session artifacts. These live inside the
# repo, so without this a `git add -A` sweeps an entire second checkout into a
# commit — and ESLint walks them and reports another branch's warnings as ours.
.claude/
.playwright-mcp/
dev-*.log
